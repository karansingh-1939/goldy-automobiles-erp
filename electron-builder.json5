{
  // Core Application Metadata
  appId: 'com.goldyautomobiles.erp',
  productName: 'GOLDY AUTOMOBILE ERP',
  copyright: 'Copyright © 2026 GOLDY AUTOMOBILE',

  // Packaging Rules
  files: [
    'src/desktop/**/*',
    'src/server/**/*',
    'dist/renderer/**/*',
    'package.json',
    // Exclude developer configuration, backups, local database copies, and tests
    '!tests/**/*',
    '!data/**/*',
    '!.git/**/*',
    '!.env*',
    '!**/*.log',
  ],
  directories: { output: 'release' },

  // Security and Module Support
  asar: true, // Package application code into ASAR archive
  // better-sqlite3 13 ships Node-API binaries, verified by postinstall in Electron.
  npmRebuild: false,
  electronDist: 'node_modules/electron/dist',
  asarUnpack: ['**/node_modules/better-sqlite3/**/*'],

  // Windows Specific Configuration
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
  },

  // NSIS Installer Configuration
  nsis: {
    oneClick: false, // Wizard-based custom installation steps
    allowToChangeInstallationDirectory: true, // User can customize installation target directory
    perMachine: true, // Install to Program Files (requires UAC admin privileges)
    createDesktopShortcut: 'always', // Create Desktop shortcut
    createStartMenuShortcut: true, // Create Start Menu shortcut
    shortcutName: 'GOLDY AUTOMOBILE ERP',
    uninstallDisplayName: 'GOLDY AUTOMOBILE ERP',
    deleteAppDataOnUninstall: false, // Ensure database, logs, and backups are NOT removed during uninstalls
    runAfterFinish: true, // Offer running the app immediately after installation finishes
  },
}
