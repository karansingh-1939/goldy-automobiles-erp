{
  "name": "goldy-automobiles-erp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline-first Windows workshop ERP for GOLDY AUTOMOBILE.",
  "main": "src/desktop/main.js",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "node scripts/verify-native-runtime.js",
    "dev": "npm run build:fe && node scripts/start-desktop.js",
    "start": "npm run dev",
    "start:server": "npm run build:fe && node scripts/run-electron-node.js src/server/server.js",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:fe": "vite build",
    "build": "npm run build:fe",
    "db:migrate": "node scripts/run-electron-node.js src/server/database/migrate.js",
    "db:seed": "node scripts/run-electron-node.js src/server/database/seed.js",
    "db:init": "node scripts/run-electron-node.js src/server/database/init.js",
    "test": "npm run build:fe && npm run test:server && npm run test:renderer",
    "test:server": "node scripts/test-server.js",
    "test:renderer": "vitest run",
    "benchmark": "node scripts/run-electron-node.js scripts/benchmark.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts public *.js --max-warnings 0",
    "check": "npm run format:check && npm run lint && npm test",
    "pack": "npm run build:fe && electron-builder --dir",
    "build:win": "npm run build:fe && electron-builder --win"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.45.0",
    "@tanstack/react-table": "^8.17.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  }
}
