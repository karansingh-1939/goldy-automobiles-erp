    "@tanstack/react-table": "^8.17.3",
    "chart.js": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.0",
    "vite": "^5.2.11",
    "@vitejs/plugin-react": "^4.3.0",
