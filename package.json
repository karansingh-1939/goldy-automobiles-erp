  "private": true,
  "type": "module",
  "description": "Offline-first desktop ERP backend foundation for GOLDY AUTOMOBILE.",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build:fe": "vite build",
    "start": "node src/server/server.js",
